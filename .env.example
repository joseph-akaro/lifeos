# Neon Postgres — Console > Connect > copy the pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon Auth — Console > Auth (Better Auth) > Settings > Project Info
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Comma-separated emails that get the admin role
ADMIN_EMAILS=josephmmakaro@gmail.com
